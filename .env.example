# Copy to .env and adjust. Never commit real secrets.

# HTTP port for the app
PORT=3000

# SQLite database file (created automatically)
DATABASE_PATH=./data/nexus.db

# Secret used to sign session tokens. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in hours
SESSION_TTL_HOURS=72

# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# Demo mode: shows the seeded demo accounts on the login page.
# Turn OFF for anything other than a local demo.
DEMO_MODE=true

# Password given to every seeded demo account (local demo only)
SEED_DEMO_PASSWORD=Demo@1234

# Optional: restrict self-registration to one email domain (e.g. srmist.edu.in).
# Leave empty to allow any email address.
ALLOWED_EMAIL_DOMAIN=
